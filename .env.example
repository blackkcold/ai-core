# Copy to .env and export variables in your process (AI Core does NOT auto-load .env).
AI_CORE_HOST=127.0.0.1
AI_CORE_PORT=8765
AI_CORE_URL=http://127.0.0.1:8765
AI_CORE_TOKEN=
# JSON object mapping distinct project IDs to distinct 24+ character tokens.
AI_CORE_PROJECT_TOKENS={}
AI_CORE_STATE_DB=./.ai-core-state.sqlite3
AI_CORE_ALLOWED_ORIGINS=
AI_CORE_TIMEOUT_SECONDS=20

# Defaults permit only keyless search, conservatively capped by local guards.
AI_CORE_SEARCH_ENABLED=tavily,firecrawl
AI_CORE_ALLOW_METERED_SEARCH=0
AI_CORE_SEARCH_DAILY_LIMITS=tavily=100,firecrawl=40
AI_CORE_SEARCH_MONTHLY_LIMITS=
AI_CORE_SEARCH_CACHE_SECONDS=3600

# No remote billable model calls until explicitly opted in.
AI_CORE_LLM_DAILY_LIMIT=0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
MINIMAX_API_KEY=
ARK_API_KEY=
OPENCODE_API_KEY=

# Explicitly opt into keyed search and set caps before enabling providers.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
TINYFISH_API_KEY=
EXA_API_KEY=
PARALLEL_API_KEY=
BRAVE_API_KEY=
