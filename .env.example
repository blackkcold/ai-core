# Copy to .env. Python does not auto-load this file; Docker Compose does.
AI_CORE_HOST=127.0.0.1
AI_CORE_PORT=8765
AI_CORE_URL=http://127.0.0.1:8765
AI_CORE_TOKEN=
AI_CORE_PROJECT_TOKENS={}
AI_CORE_STATE_DB=./.ai-core-state.sqlite3
AI_CORE_ALLOWED_ORIGINS=
AI_CORE_TIMEOUT_SECONDS=20

# Keyless general web via official free You.com MCP (up to 100/day)
# plus specialist public research, reference and developer APIs.
AI_CORE_SEARCH_ENABLED=you-free-mcp,wikipedia,hackernews,openalex,crossref,europepmc,stackoverflow,openlibrary
AI_CORE_ALLOW_METERED_SEARCH=0
# Local attempt ceilings, not official free entitlements.
AI_CORE_SEARCH_DAILY_LIMITS=you-free-mcp=60,wikipedia=60,hackernews=50,openalex=40,crossref=40,europepmc=40,stackoverflow=30,openlibrary=30
AI_CORE_SEARCH_MONTHLY_LIMITS=
AI_CORE_SEARCH_CACHE_SECONDS=3600

# Remote paid model calls disabled by default.
AI_CORE_LLM_DAILY_LIMIT=0
AI_CORE_FREE_CLOUD_DAILY_LIMIT=20
AI_CORE_LOCAL_MODEL=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
OLLAMA_API_KEY=
MINIMAX_API_KEY=
ARK_API_KEY=
OPENCODE_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
DASHSCOPE_API_KEY=
SILICONFLOW_API_KEY=

# Paid/keyed search is opt-in. Per-source budgets must be supplied.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
TINYFISH_API_KEY=
EXA_API_KEY=
PARALLEL_API_KEY=
BRAVE_API_KEY=
PERPLEXITY_API_KEY=
YDC_API_KEY=
JINA_API_KEY=
NEWSAPI_API_KEY=
# SearXNG URL must stay loopback /search; never arbitrary remote URL.
AI_CORE_SEARXNG_URL=http://127.0.0.1:8081/search
